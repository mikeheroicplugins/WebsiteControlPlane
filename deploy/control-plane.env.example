# Install as /etc/geekheros/control-plane.env with root ownership and mode 0600.
# Generate TWO different values with: openssl rand -hex 32
GEEKHEROS_AGENT_TOKEN=
GEEKHEROS_WEB_TOKEN=
GEEKHEROS_DEPLOYMENT_MODE=vps
GEEKHEROS_DATA_DIR=/var/lib/geekheros
GEEKHEROS_PUBLIC_URL=https://control.example.com
GEEKHEROS_NODE_NAME=GeekHeros VPS
GEEKHEROS_SITE_SCHEME=https
GEEKHEROS_AGENT_HOST=127.0.0.1
GEEKHEROS_AGENT_PORT=8788
GEEKHEROS_WEB_PORT=3080
GEEKHEROS_EDGE_HTTP_PORT=8080
GEEKHEROS_EDGE_HTTPS_PORT=8443
# Optional: override Chromium discovery on the VPS.
# GEEKHEROS_BROWSER_PATH=/usr/bin/chromium
# Set both for Caddy. Keep the literal bcrypt hash (including dollar signs).
# Obtain the hash interactively with: caddy hash-password
GEEKHEROS_ADMIN_USER=admin
GEEKHEROS_ADMIN_PASSWORD_HASH=
GEEKHEROS_MANAGEMENT_HOST=control.example.com
